# Port the dashboard web UI is exposed on (host machine)
DASHBOARD_PORT=3000

# Coordinates for the local weather card. Find yours at https://www.latlong.net/
WEATHER_LAT=40.7128
WEATHER_LON=-74.0060
WEATHER_LOCATION_NAME=New York

# "fahrenheit" or "celsius"
WEATHER_UNITS=fahrenheit

# Comma-separated list of mountpoints to show on the Storage card
DISK_MOUNTPOINTS=/
