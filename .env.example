# Port the dashboard web UI is exposed on (host machine)
DASHBOARD_PORT=3000

# Coordinates for the local weather card. Find yours at https://www.latlong.net/
WEATHER_LAT=40.7128
WEATHER_LON=-74.0060
WEATHER_LOCATION_NAME=New York

# "fahrenheit" or "celsius"
WEATHER_UNITS=fahrenheit

# Comma-separated list of mountpoints to show on the Storage card
DISK_MOUNTPOINTS=/

# Port Grafana is exposed on (host machine)
GRAFANA_PORT=3001

# Change these before exposing Grafana beyond your own network
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Optional regex overrides (case-insensitive) for classifying temperature
# sensors as CPU vs GPU on unusual hardware. Leave blank to use the defaults,
# which cover most Intel/AMD CPUs and AMD GPUs exposed via hwmon.
# See README > Temperatures for how to find your chip names if the defaults
# misclassify a sensor.
TEMP_CPU_CHIP_REGEX=
TEMP_GPU_CHIP_REGEX=
